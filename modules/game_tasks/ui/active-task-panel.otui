ActiveTaskPanel < Panel
  id: activeTaskPanel
  width: 190

  Panel
    id: activeTaskHeader
    height: 26
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Label
      id: activeTitle
      text: Current Task
      font: verdana-11px-rounded
      color: #b8b8b8
      anchors.fill: parent
      text-align: center

  Panel
    id: activeTaskContent
    anchors.top: activeTaskHeader.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 138
    margin-top: 4
    background-color: #111111
    border-width: 1
    border-color: #333333

    Panel
      id: activeTaskBase
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: activeTaskFooter.top
      margin: 4

    Label
      id: emptyActiveLabel
      text: No active task
      font: verdana-11px-rounded
      color: #777777
      anchors.centerIn: activeTaskBase
      visible: false

    Panel
      id: activeTaskFooter
      height: 50
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      background-color: #1a1a1a
      border-width: 1
      border-color: #333333

      Button
        id: rewardButton
        text: Claim Reward
        height: 20
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 4 4 0 4
        @onClick: TaskUI.taskRewardRequest()

      Button
        id: pauseButton
        text: Pause
        height: 20
        anchors.top: rewardButton.bottom
        anchors.left: parent.left
        width: 86
        margin-left: 4
        margin-top: 3
        @onClick: TaskUI.pauseTask()
        enabled: false

      Button
        id: cancelTaskButton
        text: Cancel
        height: 20
        anchors.top: rewardButton.bottom
        anchors.left: pauseButton.right
        anchors.right: parent.right
        margin-left: 4
        margin-right: 4
        margin-top: 3
        color: #ff6666
        @onClick: TaskUI.cancelTask()
        enabled: false

  Panel
    id: pausedTitleHeader
    height: 24
    anchors.top: activeTaskContent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Label
      id: pausedTitle
      text: PAUSED (0)
      font: verdana-11px-rounded
      color: #e0a33a
      anchors.fill: parent
      text-align: center

  ScrollablePanel
    id: pausedTaskContainer
    anchors.top: pausedTitleHeader.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 4
    padding: 4 14 4 4
    vertical-scrollbar: pausedScrollBar
    background-color: #111111
    border-width: 1
    border-color: #333333
    layout:
      type: verticalBox
      spacing: 4

  VerticalScrollBar
    id: pausedScrollBar
    width: 10
    anchors.top: pausedTaskContainer.top
    anchors.bottom: pausedTaskContainer.bottom
    anchors.right: pausedTaskContainer.right
    margin-top: 3
    margin-right: 2
    margin-bottom: 3
    step: 40
    pixels-scroll: true
    auto-hide: true
