SpellBoosterConfirmDialog < MainWindow
  id: spellBoosterConfirmDialog
  size: 340 175
  text: Confirm Spell Boost
  draggable: true
  @onEscape: self:destroy()

  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonPanel.top
    margin: 8
    padding: 8
    background-color: #111111
    border-width: 1
    border-color: #333333

    Label
      id: confirmLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      text-align: center
      text: Do you want to boost this spell?
      font: cipsoftFont
      color: #ffffff

    Label
      id: spellNameLabel
      anchors.top: confirmLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      text-align: center
      text: placeholder
      color: #8fbd8f
      font: verdana-11px-rounded

    Label
      id: costLabel
      anchors.top: spellNameLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      text-align: center
      text: Cost: placeholder gold coins
      color: #ffd75e
      font: verdana-11px-rounded

  Panel
    id: buttonPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 48
    margin-left: 8
    margin-right: 8
    margin-bottom: 6
    background-color: #111111
    border-width: 1
    border-color: #333333

    Label
      id: errorMessage
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 3
      height: 14
      text-align: center
      color: #ff6666
      font: verdana-11px-antialised

    Button
      id: cancelButton
      text: Cancel
      size: 100 22
      anchors.right: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-right: 5
      margin-bottom: 4
      @onClick: self:getParent():getParent():destroy()

    Button
      id: confirmButton
      text: Confirm Boost
      size: 100 22
      anchors.left: parent.horizontalCenter
      anchors.bottom: parent.bottom
      margin-left: 5
      margin-bottom: 4
      background-color: #2f6f3a
      hover-color: #3d8c4a
      font: verdana-11px-rounded
      @onClick: SpellBoosterUI.confirmBoost(self:getParent():getParent():getId())
