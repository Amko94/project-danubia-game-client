StartTaskDialog < MainWindow
  id: startTaskDialog
  size: 350 390
  text: Task Assignment
  @onEscape: self:destroy()

  Panel
    id: monsterSection
    height: 70
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    background-color: #111111
    border-width: 1
    border-color: #333333

    Panel
      id: iconContainer
      height: 60
      anchors.centerIn: parent
      layout:
        type: horizontalBox
        spacing: -15
        fit-size: true
        align-center: true

  Panel
    id: amountSection
    height: 48
    anchors.top: monsterSection.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 7
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Label
      id: amountLabel
      text: Kill amount:
      font: verdana-11px-rounded
      color: #eeeeee
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 12

    TextEdit
      id: amountInput
      placeholder: 50 - 1000
      size: 125 24
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      margin-right: 12
      background-color: #0d0d0dcc
      border-width: 1
      border-color: #444444
      @onTextChange: TaskUI.updateTaskAmount(self:getParent():getParent(), self:getText())

    Label
      id: errorLabel
      text: Only numbers allowed
      font: verdana-11px-rounded
      color: #ff6666
      visible: false
      anchors.bottom: parent.bottom
      anchors.right: amountInput.right
      margin-bottom: 1

  Label
    id: rewardLabel
    text: Reward Preview
    font: verdana-11px-rounded
    color: #b8b8b8
    anchors.top: amountSection.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    text-align: center

  Panel
    id: goldCoinRewardSection
    size: 96 120
    anchors.top: rewardLabel.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 10
    background-color: #1a1a1a
    border-width: 1
    border-color: #4a4326

    Label
      id: goldCoinRewardLabel
      text: Gold
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffd75e
      margin-top: 6
      text-align: center

    UIWidget
      id: goldCoinRewardIcon
      image-source: /images/game/prey/prey_bigloot.png
      size: 44 64
      anchors.centerIn: parent
      phantom: true

    Label
      id: goldCoinAmount
      text: 0
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffd75e
      margin-bottom: 6
      text-align: center

  Panel
    id: expRewardSection
    size: 96 120
    anchors.top: goldCoinRewardSection.top
    anchors.left: goldCoinRewardSection.right
    margin-left: 10
    background-color: #1a1a1a
    border-width: 1
    border-color: #49334d

    Label
      id: expRewardLabel
      text: Experience
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #dc78d0
      margin-top: 6
      text-align: center

    UIWidget
      id: expRewardIcon
      image-source: /images/game/prey/prey_bigxp.png
      size: 44 64
      anchors.centerIn: parent
      phantom: true

    Label
      id: expAmount
      text: 0
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #dc78d0
      margin-bottom: 6
      text-align: center

  Panel
    id: taskPointsRewardSection
    size: 96 120
    anchors.top: goldCoinRewardSection.top
    anchors.left: expRewardSection.right
    margin-left: 10
    background-color: #1a1a1a
    border-width: 1
    border-color: #4a4326

    Label
      id: taskPointsRewardLabel
      text: Task Points
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffe81f
      margin-top: 6
      text-align: center

    UIWidget
      id: taskPointsRewardIcon
      image-source: /images/game/prey/task_points.png
      size: 44 64
      anchors.centerIn: parent
      phantom: true

    Label
      id: taskPointsAmount
      text: 0
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffe81f
      margin-bottom: 6
      text-align: center

  Panel
    id: buttonPanel
    height: 32
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    background-color: #111111
    border-width: 1
    border-color: #333333

    Button
      id: cancelButton
      text: Close
      size: 100 22
      anchors.right: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 5
      @onClick: self:getParent():getParent():destroy()

    Button
      id: okButton
      text: Start Task
      size: 100 22
      anchors.left: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      @onClick: TaskUI.confirmStartTask()
