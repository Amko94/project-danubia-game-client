ConfirmDialog < MainWindow
  id: confirmDialog
  size: 310 155
  text: Confirm Cancellation
  draggable: true
  @onEscape: self:destroy()

  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonPanel.top
    margin-bottom: 7
    background-color: #111111
    border-width: 1
    border-color: #333333

    Label
      id: confirmLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 14
      text-align: center
      text: Are you sure you want to cancel this task?
      font: verdana-11px-rounded
      color: #eeeeee

    Label
      id: taskNameAndProcess
      anchors.top: confirmLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      text-align: center
      text: placeholder
      font: verdana-11px-rounded
      color: #ffd75e

  Panel
    id: buttonPanel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 32
    background-color: #111111
    border-width: 1
    border-color: #333333

    Button
      id: abortButton
      text: Close
      size: 100 22
      anchors.right: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 5
      @onClick: self:getParent():getParent():destroy()

    Button
      id: confirmButton
      text: Cancel Task
      size: 100 22
      anchors.left: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      color: #ff6666
      hover-color: #cc4444
      font: verdana-11px-rounded
      @onClick: TaskUI.confirmCancel()
