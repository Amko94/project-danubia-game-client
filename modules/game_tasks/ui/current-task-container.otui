CurrentTaskContainer < Panel
  anchors.fill: parent
  padding: 5
  background-color: #161616
  border-width: 1
  border-color: #333333

  UICreature
    id: monsterIcon
    size: 48 48
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    phantom: true

  Label
    id: taskName
    font: verdana-11px-rounded
    color: #ffffff
    anchors.top: parent.top
    anchors.left: monsterIcon.right
    anchors.right: parent.right
    margin-left: 9
    margin-right: 5
    margin-top: 8
    text-align: left

  Panel
    id: progressPanel
    height: 16
    anchors.top: taskName.bottom
    anchors.left: monsterIcon.right
    anchors.right: parent.right
    margin-left: 9
    margin-top: 6
    margin-right: 5
    background-color: #090909cc
    border-width: 1
    border-color: #3d3d3d

    Panel
      id: progressBar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 0
      margin: 1
      background-color: #2f7d3a

    Label
      id: progressLabel
      font: verdana-11px-antialised
      color: #ffffff
      anchors.fill: parent
      text-align: center
