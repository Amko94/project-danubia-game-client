TaskTab < TabButton
  height: 28
  font: verdana-11px-rounded
  color: #b8b8b8
  background-color: #1a1a1a
  border-width: 1
  border-color: #333333

  $hover !on:
    color: #ffffff
    background-color: #292929
    border-color: #555555

  $on:
    color: #ffffff
    background-color: #355d89
    border-color: #6f9dcc

TaskWindow < MainWindow
  id: taskWindow
  text: Tasks
  size: 740 680
  draggable: true
  @onEscape: self:destroy()
  onDestroy: modules.game_tasks.onWindowDestroy()

  Label
    id: statusLabel
    visible: false

  ActiveTaskPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: taskPointsChip.top
    width: 190
    margin-bottom: 5

  Panel
    id: categoryPanel
    anchors.top: parent.top
    anchors.left: activeTaskPanel.right
    anchors.right: parent.right
    height: 28
    margin-left: 8

    layout:
      type: grid
      num-columns: 5
      cell-size: 101 28
      cell-spacing: 2

    TaskTab
      id: categoryAll
      text: All
      @onClick: TaskUI.filterByCategory(0)

    TaskTab
      id: categoryLow
      text: Low
      @onClick: TaskUI.filterByCategory(1)

    TaskTab
      id: categoryMedium
      text: Medium
      @onClick: TaskUI.filterByCategory(2)

    TaskTab
      id: categoryHard
      text: Hard
      @onClick: TaskUI.filterByCategory(3)

    TaskTab
      id: categoryVeryHard
      text: Very Hard
      @onClick: TaskUI.filterByCategory(4)

  Panel
    id: filterPanel
    anchors.top: categoryPanel.bottom
    anchors.left: activeTaskPanel.right
    anchors.right: parent.right
    height: 38
    margin-top: 7
    margin-left: 8
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Label
      text: Search:
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      font: verdana-11px-rounded
      color: #eeeeee
      text-auto-resize: true

    TextEdit
      id: filterInput
      height: 24
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      margin-right: 10
      placeholder: Search monster...
      background-color: #0d0d0dcc
      border-width: 1
      border-color: #444444
      @onTextChange: TaskUI.filterTasks(self:getText())

  ScrollablePanel
    id: taskList
    anchors.top: filterPanel.bottom
    anchors.left: activeTaskPanel.right
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-top: 7
    margin-left: 8
    margin-bottom: 7
    padding: 6 20 6 6
    vertical-scrollbar: taskListScrollBar
    background-color: #111111
    border-width: 1
    border-color: #333333

    layout:
      type: grid
      num-columns: 3
      cell-size: 160 150
      spacing: 7

  Label
    id: emptyList
    visible: false
    text: No monsters found.
    color: #aaaaaa
    font: verdana-11px-rounded
    text-align: center
    anchors.fill: taskList

  VerticalScrollBar
    id: taskListScrollBar
    width: 14
    anchors.top: taskList.top
    anchors.bottom: taskList.bottom
    anchors.right: taskList.right
    margin-top: 6
    margin-right: 4
    margin-bottom: 6
    step: 50
    pixels-scroll: true

  Panel
    id: taskPointsChip
    height: 24
    width: 190
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    margin-bottom: 6
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Label
      id: taskPointsLabel
      text: Points: 0
      font: verdana-11px-rounded
      color: #ffd75e
      anchors.fill: parent
      text-align: center

  Button
    id: closeButton
    text: Close
    size: 76 22
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: TaskUI.hide()
