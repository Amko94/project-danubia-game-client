ShopTab < UIButton
  size: 150 26
  font: verdana-11px-rounded
  color: #b8b8b8
  background-color: #1a1a1a
  border-width: 1
  border-color: #333333
  text-offset: 0 1
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    color: #ffffff
    background-color: #292929
    border-color: #555555

  $on:
    color: #ffffff
    background-color: #355d89
    border-color: #6f9dcc

ShopCategoryButton < UIButton
  height: 34
  font: verdana-11px-rounded
  color: #b8b8b8
  text-align: left
  text-offset: 12 1
  background-color: #1a1a1a
  border-width: 1
  border-color: #333333
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    color: #ffffff
    background-color: #292929
    border-color: #555555

  $on:
    color: #ffffff
    background-color: #355d89
    border-color: #6f9dcc

  Label
    id: count
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    text-auto-resize: true
    color: #aaaaaa
    phantom: true

ShopPill < UIButton
  height: 20
  font: verdana-11px-antialised
  color: #b8b8b8
  background-color: #00000000
  border-width: 1
  border-color: #444444
  text-offset: 0 1
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    color: #ffffff
    background-color: #292929
    border-color: #777777

  $on:
    color: #ffffff
    background-color: #355d89
    border-color: #6f9dcc

ShopGoldButton < UIButton
  height: 24
  font: verdana-11px-antialised
  color: #1e1404
  background-color: #c9962e
  border-width: 1
  border-color: #f0c75e
  text-offset: 0 1
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    background-color: #e0ad42
    border-color: #ffe08a

  $pressed:
    background-color: #a67c27
    text-offset: 1 2

  $disabled:
    color: #8a7a5a
    background-color: #2a2216
    border-color: #4a3a1e
    change-cursor-image: false

ShopDivider < UIWidget
  height: 1
  background-color: #4a4a4a
  phantom: true

ShopOfferCard < UIWidget
  size: 176 240
  background-color: #1a1a1a
  border-width: 1
  border-color: #444444
  clipping: true

  $hover:
    background-color: #272727
    border-color: #6f9dcc

  UIWidget
    id: preview
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 5 5 0 5
    height: 100
    background-color: #0d0d0dcc
    border-width: 1
    border-color: #333333
    phantom: true

    UIItem
      id: item
      size: 64 64
      anchors.centerIn: parent
      virtual: true
      phantom: true
      visible: false

    UICreature
      id: creature
      size: 96 96
      anchors.centerIn: parent
      phantom: true
      visible: false

    UIWidget
      id: image
      size: 117 98
      anchors.centerIn: parent
      image-fixed-ratio: true
      image-smooth: true
      phantom: true
      visible: false

    Label
      id: badge
      anchors.top: parent.top
      anchors.left: parent.left
      margin: 4
      padding: 1 5 1 5
      text-auto-resize: true
      color: #1a1206
      background-color: #d4a843
      phantom: true
      visible: false

  Label
    id: name
    anchors.top: preview.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 7 6 0 6
    height: 16
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff

  ShopDivider
    id: divider
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    width: 120

  Label
    id: description
    anchors.top: divider.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 5 8 0 8
    height: 42
    text-wrap: true
    text-align: top
    color: #b8b8b8

  ShopGoldButton
    id: buyButton
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 8 8 8
    !text: tr('Buy')

  Label
    id: price
    anchors.bottom: buyButton.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 6
    margin-left: 7
    font: sans-bold-16px
    text-auto-resize: true
    color: #f0c75e

  UIItem
    id: coin
    size: 32 32
    anchors.right: price.left
    anchors.verticalCenter: price.verticalCenter
    margin-right: 1
    virtual: true
    phantom: true

ShopBadge < Label
  size: 84 18
  text-align: center
  border-width: 1

ShopHistoryColumns < UIWidget
  height: 36

  Label
    id: balance
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    width: 80
    text-align: right
    color: #b8b8b8

  Label
    id: amount
    anchors.right: balance.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    width: 70
    text-align: right
    font: verdana-11px-rounded

  ShopBadge
    id: status
    anchors.right: amount.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 12
    width: 76

  Label
    id: date
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    size: 92 30
    text-align: left
    color: #aaaaaa

  ShopBadge
    id: type
    anchors.left: date.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  Label
    id: details
    anchors.left: type.right
    anchors.right: status.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    margin-right: 12
    height: 30
    text-align: left
    text-wrap: true
    color: #eeeeee

ShopHistoryRow < ShopHistoryColumns
  background-color: #00000000

  $hover:
    background-color: #355d8933

ShopHistoryRowAlt < ShopHistoryRow
  background-color: #ffffff08

ShopSummaryRow < UIWidget
  height: 22

  Label
    id: caption
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    text-auto-resize: true
    color: #b8b8b8

  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 12
    text-auto-resize: true
    font: verdana-11px-rounded
    color: #ffffff

MainWindow
  id: shopWindow
  !text: tr('Danubia Shop')
  size: 800 640
  @onEscape: modules.game_shop.hide()

  Panel
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 52
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Label
      id: balanceCaption
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 8
      margin-left: 14
      !text: tr('YOUR BALANCE')
      font: verdana-9px-bold
      color: #aaaaaa
      text-auto-resize: true

    UIItem
      id: balanceCoin
      size: 32 32
      anchors.left: balanceCaption.left
      anchors.top: balanceCaption.bottom
      margin-top: 1
      virtual: true
      phantom: true

    Label
      id: balanceValue
      anchors.left: balanceCoin.right
      anchors.verticalCenter: balanceCoin.verticalCenter
      margin-left: 6
      text: -
      font: sans-bold-16px
      color: #f0c75e
      text-auto-resize: true

    Label
      id: balanceUnit
      anchors.left: balanceValue.right
      anchors.verticalCenter: balanceValue.verticalCenter
      margin-left: 6
      margin-top: 2
      !text: tr('Danubia Points')
      color: #b8b8b8
      text-auto-resize: true

    ShopGoldButton
      id: getPointsButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 12
      width: 120
      !text: tr('+ Get Points')
      @onClick: modules.game_shop.openWebsite('/buy-points')

    Label
      id: deliveryLabel
      anchors.right: getPointsButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 16
      text-auto-resize: true
      color: #aaaaaa

  Panel
    id: tabBar
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 26
    layout:
      type: horizontalBox
      spacing: 4

    ShopTab
      id: shopTab
      !text: tr('Shop')
      @onClick: modules.game_shop.selectTab('shop')

    ShopTab
      id: historyTab
      !text: tr('History')
      @onClick: modules.game_shop.selectTab('history')

    ShopTab
      id: transferTab
      !text: tr('Transfer Points')
      @onClick: modules.game_shop.selectTab('transfer')

  ShopDivider
    id: tabDivider
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  Panel
    id: shopPanel
    anchors.top: tabDivider.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerSeparator.top
    margin-top: 8
    margin-bottom: 8

    Panel
      id: categoryList
      anchors.top: parent.top
      anchors.left: parent.left
      width: 176
      height: 148
      layout:
        type: verticalBox
        spacing: 4

      ShopCategoryButton
        id: category1
        !text: tr('Premium Account')
        @onClick: modules.game_shop.selectCategory(1)

      ShopCategoryButton
        id: category2
        !text: tr('Outfits')
        @onClick: modules.game_shop.selectCategory(2)

      ShopCategoryButton
        id: category3
        !text: tr('Items')
        @onClick: modules.game_shop.selectCategory(3)

      ShopCategoryButton
        id: category4
        !text: tr('Services')
        @onClick: modules.game_shop.selectCategory(4)

    Panel
      id: infoBox
      anchors.top: categoryList.bottom
      anchors.left: categoryList.left
      anchors.right: categoryList.right
      anchors.bottom: parent.bottom
      margin-top: 8
      background-color: #111111
      border-width: 1
      border-color: #333333

      Label
        id: infoTitle
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 10 10 0 10
        !text: tr('How it works')
        font: verdana-11px-rounded
        color: #80c7f8

      ShopDivider
        anchors.top: infoTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 6 10 0 10

      Label
        id: infoText
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 8 10 10 10
        text-wrap: true
        text-align: topleft
        color: #aaaaaa
        !text: tr('Everything you buy here is delivered to the character you are playing within a few seconds.\n\nItems go to your backpack, or to your depot if you have no room.\n\nPurchases made on the website show up in your history as well.')

    Panel
      id: offersColumn
      anchors.top: parent.top
      anchors.left: categoryList.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 8

      Label
        id: categoryTitle
        anchors.top: parent.top
        anchors.left: parent.left
        height: 22
        font: sans-bold-16px
        color: #ffffff
        text-auto-resize: true

      Panel
        id: subCategoryBar
        anchors.right: parent.right
        anchors.verticalCenter: categoryTitle.verticalCenter
        height: 20
        width: 384
        layout:
          type: horizontalBox
          spacing: 4

        ShopPill
          id: subCategory0
          width: 36
          !text: tr('All')
          @onClick: modules.game_shop.selectSubCategory(0)

        ShopPill
          id: subCategory2
          width: 76
          !text: tr('House Deco')
          @onClick: modules.game_shop.selectSubCategory(2)

        ShopPill
          id: subCategory3
          width: 62
          !text: tr('Utilities')
          @onClick: modules.game_shop.selectSubCategory(3)

        ShopPill
          id: subCategory4
          width: 62
          !text: tr('Weapons')
          @onClick: modules.game_shop.selectSubCategory(4)

        ShopPill
          id: subCategory5
          width: 72
          !text: tr('Equipment')
          @onClick: modules.game_shop.selectSubCategory(5)

        ShopPill
          id: subCategory6
          width: 56
          !text: tr('Addons')
          @onClick: modules.game_shop.selectSubCategory(6)

      Panel
        id: offerArea
        anchors.top: categoryTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 8
        background-color: #111111
        border-width: 1
        border-color: #333333

        ScrollablePanel
          id: offerList
          anchors.fill: parent
          margin: 8 22 8 10
          vertical-scrollbar: offerScrollBar
          layout:
            type: grid
            num-columns: 3
            cell-size: 176 240
            cell-spacing: 8

        VerticalScrollBar
          id: offerScrollBar
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          margin: 4
          step: 64
          pixels-scroll: true

        Label
          id: offersEmpty
          anchors.centerIn: parent
          text-auto-resize: true
          color: #aaaaaa
          visible: false

  Panel
    id: historyPanel
    anchors.top: tabDivider.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerSeparator.top
    margin-top: 8
    margin-bottom: 8
    visible: false

    Panel
      id: historyFilterBar
      anchors.top: parent.top
      anchors.left: parent.left
      height: 20
      width: 340
      layout:
        type: horizontalBox
        spacing: 4

      ShopPill
        id: filterAll
        width: 50
        !text: tr('All')
        @onClick: modules.game_shop.selectHistoryFilter('all')

      ShopPill
        id: filterTopup
        width: 90
        !text: tr('Points Top-ups')
        @onClick: modules.game_shop.selectHistoryFilter('topup')

      ShopPill
        id: filterPurchase
        width: 90
        !text: tr('Shop Purchases')
        @onClick: modules.game_shop.selectHistoryFilter('purchase')

      ShopPill
        id: filterTransfer
        width: 70
        !text: tr('Transfers')
        @onClick: modules.game_shop.selectHistoryFilter('transfer')

    Label
      id: historyInfo
      anchors.right: parent.right
      anchors.verticalCenter: historyFilterBar.verticalCenter
      text-auto-resize: true
      color: #aaaaaa

    ShopHistoryColumns
      id: historyHeader
      anchors.top: historyFilterBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      height: 24
      background-color: #1a1a1a
      border-width: 1
      border-color: #333333
      padding-right: 18

    Panel
      id: historyArea
      anchors.top: historyHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      background-color: #111111
      border-width: 1
      border-color: #333333

      ScrollablePanel
        id: historyList
        anchors.fill: parent
        margin: 1 18 1 1
        vertical-scrollbar: historyScrollBar
        layout:
          type: verticalBox

      VerticalScrollBar
        id: historyScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin: 4
        step: 36
        pixels-scroll: true

      Label
        id: historyEmpty
        anchors.centerIn: parent
        text-auto-resize: true
        color: #aaaaaa
        visible: false

  Panel
    id: transferPanel
    anchors.top: tabDivider.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerSeparator.top
    margin-top: 8
    margin-bottom: 8
    visible: false

    Panel
      id: transferCard
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 16
      size: 460 388
      background-color: #1a1a1a
      border-width: 1
      border-color: #444444

      Label
        id: transferTitle
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 14
        !text: tr('Transfer Danubia Points')
        font: sans-bold-16px
        color: #ffffff
        text-auto-resize: true

      Label
        id: transferIntro
        anchors.top: transferTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 8 24 0 24
        height: 30
        text-wrap: true
        text-align: center
        color: #b8b8b8
        !text: tr('Send points from your account to another character. The points are credited to the receiving account immediately.')

      ShopDivider
        id: transferDivider
        anchors.top: transferIntro.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 10 24 0 24

      Label
        id: recipientCaption
        anchors.top: transferDivider.bottom
        anchors.left: parent.left
        margin: 14 24 0 24
        !text: tr('Receiving character')
        color: #eeeeee
        text-auto-resize: true

      TextEdit
        id: transferRecipient
        anchors.top: recipientCaption.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 4 24 0 24
        max-length: 30
        @onTextChange: modules.game_shop.updateTransferSummary()

      Label
        id: amountCaption
        anchors.top: transferRecipient.bottom
        anchors.left: parent.left
        margin: 12 24 0 24
        !text: tr('Amount')
        color: #eeeeee
        text-auto-resize: true

      SpinBox
        id: transferAmount
        anchors.top: amountCaption.bottom
        anchors.left: parent.left
        margin: 4 0 0 24
        width: 120
        minimum: 0
        maximum: 0

      Panel
        id: quickAmounts
        anchors.left: transferAmount.right
        anchors.right: parent.right
        anchors.verticalCenter: transferAmount.verticalCenter
        margin-left: 10
        margin-right: 24
        height: 20
        layout:
          type: horizontalBox
          spacing: 4

        ShopPill
          width: 60
          text: 100
          @onClick: modules.game_shop.setTransferAmount(100)

        ShopPill
          width: 60
          text: 500
          @onClick: modules.game_shop.setTransferAmount(500)

        ShopPill
          width: 60
          !text: '1,000'
          @onClick: modules.game_shop.setTransferAmount(1000)

        ShopPill
          width: 60
          !text: tr('All')
          @onClick: modules.game_shop.setTransferAmount(-1)

      Panel
        id: summary
        anchors.top: transferAmount.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 16 24 0 24
        height: 76
        background-color: #111111
        border-width: 1
        border-color: #333333
        padding-top: 4
        layout:
          type: verticalBox

        ShopSummaryRow
          id: summaryBalance

        ShopSummaryRow
          id: summaryAmount

        ShopSummaryRow
          id: summaryAfter

      Label
        id: transferError
        anchors.top: summary.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 8 24 0 24
        height: 16
        text-align: center
        color: #e07a7a

      ShopGoldButton
        id: transferButton
        anchors.top: transferError.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        width: 200
        height: 28
        !text: tr('Transfer Points')
        @onClick: modules.game_shop.transferPoints()

      Label
        id: transferWarning
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 0 24 12 24
        text-align: center
        color: #aaaaaa
        !text: tr('Double-check the name. Transfers cannot be undone.')

  HorizontalSeparator
    id: footerSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-right: 10
    color: #aaaaaa

  Button
    id: closeButton
    !text: tr('Close')
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_shop.hide()
