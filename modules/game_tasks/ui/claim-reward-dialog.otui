ClaimRewardDialog < MainWindow
  id: claimRewardDialog
  size: 420 430
  text: Claim Reward
  @onEscape: self:destroy()

  Label
    id: rewardLabel
    text: Select Your Reward
    font: verdana-11px-rounded
    color: #eeeeee
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    text-align: center

  UIWidget
    id: goldSection
    size: 110 150
    anchors.top: rewardLabel.bottom
    anchors.left: parent.left
    margin-top: 10
    margin-left: 20
    background-color: #1a1a1a
    border-width: 2
    border-color: #4a4326
    cursor: pointer

    $hover:
      background-color: #252525
      border-color: #ffd75e

    $on:
      background-color: #2f2a18
      border-width: 2
      border-color: #ffd75e

    Label
      text: Gold
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffd75e
      margin-top: 8
      text-align: center
      phantom: true

    UIWidget
      image-source: /images/game/prey/prey_bigloot.png
      size: 50 85
      anchors.centerIn: parent
      phantom: true

    Label
      id: goldAmount
      text: 0
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffd75e
      margin-bottom: 8
      text-align: center
      phantom: true

  UIWidget
    id: expSection
    size: 110 150
    anchors.top: goldSection.top
    anchors.left: goldSection.right
    margin-left: 10
    background-color: #1a1a1a
    border-width: 2
    border-color: #49334d
    cursor: pointer

    $hover:
      background-color: #252525
      border-color: #dc78d0

    $on:
      background-color: #302033
      border-width: 2
      border-color: #dc78d0

    Label
      text: Experience
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #dc78d0
      margin-top: 8
      text-align: center
      phantom: true

    UIWidget
      image-source: /images/game/prey/prey_bigxp.png
      size: 50 85
      anchors.centerIn: parent
      phantom: true

    Label
      id: expAmount
      text: 0
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #dc78d0
      margin-bottom: 8
      text-align: center
      phantom: true

  UIWidget
    id: splitSection
    size: 110 150
    anchors.top: goldSection.top
    anchors.left: expSection.right
    margin-left: 10
    background-color: #1a1a1a
    border-width: 2
    border-color: #4a4326
    cursor: pointer

    $hover:
      background-color: #252525
      border-color: #ffd75e

    $on:
      background-color: #252d35
      border-width: 2
      border-color: #ffd75e

    Label
      text: 50 / 50 Split
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #eeeeee
      margin-top: 8
      text-align: center
      phantom: true

    UIWidget
      image-source: /images/game/prey/50-50.png
      size: 50 75
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 28
      phantom: true

    Label
      id: splitExpAmount
      text: +0 EXP
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #dc78d0
      margin-bottom: 23
      text-align: center
      phantom: true

    Label
      id: splitGoldAmount
      text: +0 GOLD
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffd75e
      margin-bottom: 7
      text-align: center
      phantom: true

  Panel
    id: taskPointsPanel
    anchors.top: goldSection.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 64
    margin-top: 12
    margin-left: 20
    margin-right: 20
    background-color: #1a1a1a
    border-width: 1
    border-color: #4a4326

    Label
      text: Task Points Earned
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffe81f
      margin-top: 7
      text-align: center

    Label
      id: taskPointsAmount
      text: + 0
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-rounded
      color: #ffe81f
      margin-top: 5
      text-align: center

    Label
      text: Always earned
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      font: verdana-11px-antialised
      color: #888888
      margin-bottom: 5
      text-align: center

  Label
    id: pzWarningLabel
    text: You cannot claim rewards while in combat
    anchors.bottom: buttonPanel.top
    anchors.left: parent.left
    anchors.right: parent.right
    font: verdana-11px-rounded
    color: #ff6666
    margin-bottom: 7
    text-align: center
    visible: false

  Panel
    id: buttonPanel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34
    background-color: #111111
    border-width: 1
    border-color: #333333

    Button
      text: Cancel
      size: 110 22
      anchors.right: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 5
      @onClick: self:getParent():getParent():destroy()

    Button
      id: claimButton
      text: Confirm
      size: 110 22
      anchors.left: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      enabled: false
      color: #ffd75e
      font: verdana-11px-rounded

      $disabled:
        color: #777777

      @onClick: TaskUI.confirmClaimReward()
