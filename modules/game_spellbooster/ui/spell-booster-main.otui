SpellBoosterTab < TabButton
  height: 28
  font: verdana-11px-rounded
  color: #b8b8b8
  background-color: #1a1a1a
  border-width: 1
  border-color: #333333

  $hover !on:
    color: #ffffff
    background-color: #292929
    border-color: #555555

  $on:
    color: #ffffff
    background-color: #355d89
    border-color: #6f9dcc

SpellBoosterDialog < MainWindow
  id: spellBoosterDialog
  size: 620 680
  text: Select Spell to Boost
  @onEscape: self:destroy()

  Panel
    id: categoryPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 28

    layout:
      type: grid
      num-columns: 5
      cell-size: 112 28
      cell-spacing: 3

    SpellBoosterTab
      id: all
      text: All
      @onClick: SpellBoosterUI.filterByCategory(0)

    SpellBoosterTab
      id: attack
      text: Attack
      @onClick: SpellBoosterUI.filterByCategory(1)

    SpellBoosterTab
      id: healing
      text: Healing
      @onClick: SpellBoosterUI.filterByCategory(2)

    SpellBoosterTab
      id: support
      text: Support
      @onClick: SpellBoosterUI.filterByCategory(3)

    SpellBoosterTab
      id: conjure
      text: Conjure
      @onClick: SpellBoosterUI.filterByCategory(4)

  Panel
    id: searchPanel
    height: 38
    anchors.top: categoryPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 7
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Label
      !text: tr('Search') .. ':'
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      font: verdana-11px-rounded
      color: #eeeeee
      text-auto-resize: true

    TextEdit
      id: spellSearch
      height: 24
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      margin-right: 10
      background-color: #0d0d0dcc
      border-width: 1
      border-color: #444444
      font: verdana-11px-rounded
      color: #ffffff
      @onTextChange: SpellBoosterUI.onSearchTextChange(self:getText())

  Panel
    id: listContainer
    anchors.top: searchPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: actionFooter.top
    margin-top: 7
    margin-bottom: 7
    padding: 6
    background-color: #111111
    border-width: 1
    border-color: #333333

    ScrollablePanel
      id: spellList
      anchors.fill: parent
      margin: 3 17 3 3
      vertical-scrollbar: spellListScrollBar

      layout:
        type: grid
        num-columns: 1
        cell-size: 570 76
        cell-spacing: 6

    Label
      id: emptyList
      visible: false
      text: No spells found.
      color: #aaaaaa
      font: verdana-11px-rounded
      text-align: center
      anchors.fill: spellList

    VerticalScrollBar
      id: spellListScrollBar
      width: 14
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 6
      margin-right: 4
      margin-bottom: 6
      step: 50
      pixels-scroll: true

  Panel
    id: actionFooter
    height: 32
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    background-color: #111111
    border-width: 1
    border-color: #333333

    Button
      id: closeButton
      text: Close
      size: 76 22
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      @onClick: SpellBoosterUI.closeDialog()
