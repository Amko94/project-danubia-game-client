SpellContainer < UIWidget
  size: 570 76
  focusable: true
  clipping: true
  background-color: #1a1a1a
  border-width: 1
  border-color: #3d3d3d

  $hover:
    background-color: #252525
    border-color: #666666

  Panel
    id: leftColumn
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 58
    background-color: #00000044
    border-width: 0

    Panel
      id: iconPanel
      size: 40 40
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      background-color: #090909cc
      border-width: 1
      border-color: #444444
      phantom: true

      UIWidget
        id: spellIcon
        anchors.fill: parent
        margin: 4
        phantom: true

    UIWidget
      id: boostButton
      size: 48 18
      anchors.top: iconPanel.bottom
      anchors.horizontalCenter: iconPanel.horizontalCenter
      margin-top: 4
      @onClick: SpellBoosterUI.requestSpellPrice(self:getParent():getParent():getId())
      cursor: pointer
      image-source: /images/custom-vegura/boost_button
      opacity: 1
      z: 10

      $hover:
        image-source: /images/custom-vegura/boost_button_hover

  Label
    id: spellName
    anchors.top: parent.top
    anchors.left: leftColumn.right
    anchors.right: spellProgressBar.left
    margin-left: 10
    margin-right: 10
    margin-top: 13
    height: 18
    color: #ffffff
    font: cipsoftFont
    text-align: left
    z: 10

  Label
    id: spellWords
    anchors.top: spellName.bottom
    anchors.left: spellName.left
    anchors.right: spellName.right
    margin-top: 5
    color: #8fbd8f
    font: verdana-11px-antialised
    text-align: left
    z: 10

  UIWidget
    id: spellProgressBar
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 12
    size: 220 30
    phantom: true
