UpdaterBar < UIProgressBar
  height: 14
  background-color: #3a8dde
  border: 1 #000000
  image-source: /images/ui/progressbar
  image-border: 1
  font: verdana-11px-rounded
  text-offset: 0 1

StaticMainWindow
  id: updaterWindow
  !text: tr('Updater')
  width: 420
  height: 330

  UIWidget
    id: icon
    size: 96 96
    image-source: /images/clienticon
    image-smooth: true
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6

  Label
    id: title
    !text: tr('Danubia')
    font: verdana-11px-rounded
    color: #ffd24d
    text-align: center
    anchors.top: icon.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  Label
    id: status
    !text: tr('Checking for updates')
    text-align: center
    text-wrap: true
    height: 32
    anchors.top: title.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 10
    margin-right: 10

  UpdaterBar
    id: mainProgress
    anchors.top: status.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10

  Label
    id: downloadStatus
    text-align: center
    text-auto-resize: true
    text-wrap: true
    color: #aaaaaa
    anchors.top: mainProgress.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    visible: false

  UpdaterBar
    id: downloadProgress
    background-color: #44aa66
    anchors.top: downloadStatus.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    visible: false

  Button
    id: cancelButton
    width: 100
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    !text: tr('Cancel')
    @onClick: Updater.abort()
